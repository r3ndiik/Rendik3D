<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Visor 3D · Rendik</title>
  <style>
    :root { color-scheme: dark; --bg:#0b1020; --panel:#121a2d; --line:#26334e; --text:#eef3ff; --muted:#aab6d0; --accent:#62e6c6; }
    * { box-sizing:border-box; }
    html,body { margin:0; min-height:100%; background:var(--bg); color:var(--text); font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; }
    .wrap { width:min(1120px,100%); margin:auto; padding:clamp(12px,3vw,28px); }
    header { display:flex; gap:16px; align-items:center; justify-content:space-between; flex-wrap:wrap; margin-bottom:16px; }
    h1 { font-size:clamp(1.25rem,3vw,2rem); margin:0; letter-spacing:-.03em; }
    .eyebrow { color:var(--accent); text-transform:uppercase; letter-spacing:.13em; font-size:.75rem; font-weight:700; margin:0 0 5px; }
    .layout { display:grid; grid-template-columns:minmax(0,1fr) 260px; gap:14px; }
    .stage,.side { border:1px solid var(--line); background:var(--panel); border-radius:18px; overflow:hidden; }
    .stage { min-height:420px; position:relative; }
    #viewer { display:block; width:100%; height: min(68vh,680px); min-height:420px; touch-action:none; outline:none; }
    .status { position:absolute; left:14px; bottom:12px; max-width:calc(100% - 28px); padding:8px 11px; border-radius:10px; background:#080d19d9; color:var(--muted); font-size:.85rem; pointer-events:none; }
    .side { padding:18px; }
    .side h2 { font-size:1rem; margin:0 0 12px; }
    .controls { display:grid; gap:9px; }
    button { appearance:none; border:1px solid #354563; border-radius:11px; padding:11px 13px; background:#19243a; color:var(--text); font:inherit; font-weight:650; cursor:pointer; text-align:left; }
    button:hover { border-color:var(--accent); }
    button:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    button.primary { background:var(--accent); color:#07131a; border-color:var(--accent); text-align:center; }
    .hint { color:var(--muted); font-size:.88rem; margin:15px 0 0; }
    .footer { color:var(--muted); font-size:.8rem; margin:12px 2px 0; }
    code { color:var(--accent); }
    @media (max-width:760px) { .layout { grid-template-columns:1fr; } .stage,#viewer { min-height:340px; } #viewer { height:55vh; } .side { padding:14px; } .controls { grid-template-columns:repeat(2,minmax(0,1fr)); } button.primary { grid-column:1/-1; } }
    @media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important; } }
  </style>
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
      }
    }
  </script>
</head>
<body>
  <main class="wrap">
    <header>
      <div>
        <p class="eyebrow">Rendik · Experiencia interactiva</p>
        <h1>Explora el modelo en 3D</h1>
      </div>
    </header>
    <section class="layout" aria-label="Visor de modelo 3D">
      <div class="stage">
        <canvas id="viewer" aria-label="Modelo 3D interactivo"></canvas>
        <div id="status" class="status" role="status">Cargando visor…</div>
      </div>
      <aside class="side">
        <h2>Controles</h2>
        <div class="controls">
          <button class="primary" id="reset">Restablecer vista</button>
          <button id="rotate" aria-pressed="true">Giro automático: sí</button>
          <button id="wire">Alternar alámbrico</button>
        </div>
        <p class="hint">Ratón: arrastra para girar y usa la rueda para acercar o alejar. En móvil, usa un dedo para girar y pellizca para zoom.</p>
        <p class="hint">El modelo se carga desde <code>models/model.glb</code>. Sustituye ese archivo por tu modelo.</p>
      </aside>
    </section>
    <p class="footer">Si no aparece el modelo, comprueba la ruta del archivo y que el GLB/GLTF no dependa de texturas externas ausentes.</p>
  </main>
  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

    const canvas = document.querySelector('#viewer');
    const status = document.querySelector('#status');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#0b1020');

    const camera = new THREE.PerspectiveCamera(42, 1, 0.01, 1000);
    camera.position.set(3.2, 2.2, 4.2);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;

    scene.add(new THREE.HemisphereLight(0xffffff, 0x35405b, 2.0));
    const key = new THREE.DirectionalLight(0xffffff, 3.0);
    key.position.set(4, 7, 5);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0x7bbcff, 1.2);
    fill.position.set(-5, 2, -4);
    scene.add(fill);

    const grid = new THREE.GridHelper(10, 20, 0x33415e, 0x1b2740);
    grid.position.y = -1;
    scene.add(grid);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.07;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1.0;
    controls.minDistance = 0.05;
    controls.maxDistance = 100;
    controls.target.set(0, 0, 0);

    let model = null;
    let wireframe = false;
    const originalMaterials = [];

    function frameModel(object) {
      const box = new THREE.Box3().setFromObject(object);
      if (box.isEmpty()) return;
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());
      object.position.sub(center);
      const maxDim = Math.max(size.x, size.y, size.z) || 1;
      const fov = THREE.MathUtils.degToRad(camera.fov);
      let distance = (maxDim / (2 * Math.tan(fov / 2))) * 1.55;
      distance = Math.max(distance, 0.5);
      camera.position.set(distance * 0.85, distance * 0.55, distance);
      camera.near = Math.max(maxDim / 1000, 0.001);
      camera.far = Math.max(maxDim * 100, 100);
      camera.updateProjectionMatrix();
      controls.target.set(0, 0, 0);
      controls.minDistance = Math.max(maxDim * 0.08, 0.02);
      controls.maxDistance = maxDim * 12;
      controls.update();
      grid.position.y = -size.y / 2;
      grid.scale.setScalar(Math.max(maxDim / 10, 0.1));
    }

    function resize() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(canvas);
    window.addEventListener('resize', resize);
    resize();

    document.querySelector('#reset').addEventListener('click', () => {
      if (model) frameModel(model);
      controls.autoRotate = true;
      document.querySelector('#rotate').textContent = 'Giro automático: sí';
      document.querySelector('#rotate').setAttribute('aria-pressed', 'true');
    });
    document.querySelector('#rotate').addEventListener('click', (event) => {
      controls.autoRotate = !controls.autoRotate;
      event.currentTarget.textContent = `Giro automático: ${controls.autoRotate ? 'sí' : 'no'}`;
      event.currentTarget.setAttribute('aria-pressed', String(controls.autoRotate));
    });
    document.querySelector('#wire').addEventListener('click', () => {
      if (!model) return;
      wireframe = !wireframe;
      model.traverse((obj) => {
        if (!obj.isMesh) return;
        const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
        mats.forEach((mat) => { if (mat && 'wireframe' in mat) mat.wireframe = wireframe; });
      });
      document.querySelector('#wire').textContent = wireframe ? 'Vista normal' : 'Alternar alámbrico';
    });

    const modelUrl = new URL('./models/model.glb', import.meta.url);
    new GLTFLoader().load(
      modelUrl.href,
      (gltf) => {
        model = gltf.scene;
        scene.add(model);
        frameModel(model);
        status.textContent = 'Modelo cargado · arrastra para girar';
        setTimeout(() => { status.hidden = true; }, 4500);
      },
      (event) => {
        if (event.total) status.textContent = `Cargando modelo… ${Math.round(event.loaded / event.total * 100)}%`;
      },
      (error) => {
        console.error('No se pudo cargar el modelo 3D:', error);
        status.textContent = 'No se ha encontrado models/model.glb. Sube tu modelo GLB con ese nombre.';
      }
    );

    renderer.setAnimationLoop(() => {
      controls.update();
      renderer.render(scene, camera);
    });
  </script>
</body>
</html>
